# ECDraw 2.0 生产环境配置
# 部署前请修改所有密码和密钥

# ==================== 数据库配置 ====================
POSTGRES_PASSWORD=your_strong_password_here

# ==================== JWT 密钥（请生成随机字符串）====================
JWT_ACCESS_SECRET=your_random_32_char_access_secret
JWT_REFRESH_SECRET=your_random_32_char_refresh_secret

# ==================== 管理员账户 ====================
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=your_strong_admin_password

# ==================== 前端构建配置 ====================
VITE_API_MODE=http
VITE_API_URL=

# ==================== 服务器端口 ====================
SERVER_PORT=3001
