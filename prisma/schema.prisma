generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum DiagramStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  PENDING_DELETE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  roles        String     @default("VIEWER")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  components Component[]
  diagrams   Diagram[]
  reviews    ReviewRequest[] @relation("ReviewerReviews")
  auditLogs  AuditLog[]
}

model Component {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner    User              @relation(fields: [ownerId], references: [id])
  versions ComponentVersion[]
  instances DiagramInstance[]

  @@index([ownerId])
  @@index([category])
}

model ComponentVersion {
  id          String   @id @default(cuid())
  componentId String
  versionNo   Int
  snapshot    Json
  createdBy   String
  createdAt   DateTime @default(now())

  component Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([componentId, versionNo])
  @@index([createdAt])
}

model Diagram {
  id          String        @id @default(cuid())
  name        String
  description String?
  ownerId     String
  status      DiagramStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner     User            @relation(fields: [ownerId], references: [id])
  versions  DiagramVersion[]
  reviews   ReviewRequest[]
  instances DiagramInstance[]
  edges     DiagramEdge[]

  @@index([ownerId])
  @@index([status])
}

model DiagramVersion {
  id         String   @id @default(cuid())
  diagramId  String
  versionNo  Int
  snapshot   Json
  createdBy  String
  createdAt  DateTime @default(now())

  diagram Diagram        @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  reviews ReviewRequest[]

  @@unique([diagramId, versionNo])
  @@index([createdAt])
}

model DiagramInstance {
  id           String   @id @default(cuid())
  diagramId    String
  componentId  String
  label        String
  positionX    Float    @default(0)
  positionY    Float    @default(0)
  instanceData Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  diagram        Diagram          @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  component      Component        @relation(fields: [componentId], references: [id])
  sourceEdges    DiagramEdge[]    @relation("SourceInstance")
  targetEdges    DiagramEdge[]    @relation("TargetInstance")
  districtData   DistrictData?
  gisData        GisData?

  @@index([diagramId])
  @@index([componentId])
}

model DiagramEdge {
  id               String   @id @default(cuid())
  diagramId        String
  sourceInstanceId String
  targetInstanceId String
  sourcePinId      String
  targetPinId      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  diagram        Diagram         @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  sourceInstance DiagramInstance @relation("SourceInstance", fields: [sourceInstanceId], references: [id], onDelete: Cascade)
  targetInstance DiagramInstance @relation("TargetInstance", fields: [targetInstanceId], references: [id], onDelete: Cascade)
  lineSegmentData LineSegmentData?

  @@index([diagramId])
  @@index([sourceInstanceId])
  @@index([targetInstanceId])
}

model DistrictData {
  id                  String   @id @default(cuid())
  diagramInstanceId   String   @unique
  transformerCapacity Float?
  supplyRange         String?
  supplyArea          String?
  householdCount      Int?
  updatedBy           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  diagramInstance DiagramInstance @relation(fields: [diagramInstanceId], references: [id], onDelete: Cascade)
}

model LineSegmentData {
  id            String   @id @default(cuid())
  diagramEdgeId String   @unique
  length        Float?
  wireModel     String?
  wireOwnership String?
  wireType      String?
  isMainDisplay Boolean  @default(true)
  updatedBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  diagramEdge DiagramEdge @relation(fields: [diagramEdgeId], references: [id], onDelete: Cascade)
}

model GisData {
  id                String   @id @default(cuid())
  diagramInstanceId String   @unique
  latitude          Float?
  longitude         Float?
  updatedBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  diagramInstance DiagramInstance @relation(fields: [diagramInstanceId], references: [id], onDelete: Cascade)
}

model ReviewRequest {
  id               String       @id @default(cuid())
  diagramId        String
  diagramVersionId String
  submitterId      String
  reviewerId       String?
  status           ReviewStatus @default(PENDING)
  comment          String?
  submittedAt      DateTime     @default(now())
  reviewedAt       DateTime?

  diagram        Diagram        @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  diagramVersion DiagramVersion @relation(fields: [diagramVersionId], references: [id], onDelete: Cascade)
  reviewer       User?          @relation("ReviewerReviews", fields: [reviewerId], references: [id])

  @@index([status])
  @@index([submittedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  targetType String
  targetId   String
  payload    Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
